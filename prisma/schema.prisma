generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  idCliente Int     @id @default(autoincrement()) @map("id_cliente")
  nome      String  @db.VarChar(150)
  whatsapp  String  @db.VarChar(20)
  email     String? @db.VarChar(150)
  cep       String? @db.VarChar(10)
  endereco  String? @db.VarChar(255)

  eventos EventoOrcamento[]

  @@map("Cliente")
}

model PratoCardapio {
  idPrato   Int     @id @default(autoincrement()) @map("id_prato")
  nome      String  @db.VarChar(100)
  categoria String  @db.VarChar(50)
  descricao String?
  status    Boolean @default(true)

  escolhasMenu EscolhaMenu[]

  @@map("Prato_Cardapio")
}

model EventoOrcamento {
  idEvento               Int      @id @default(autoincrement()) @map("id_evento")
  idCliente              Int      @map("id_cliente")
  dataEvento             DateTime @map("data_evento")
  cidade                 String   @db.VarChar(100)
  bairro                 String?  @db.VarChar(100)
  tipoLocal              String   @map("tipo_local") @db.VarChar(50)
  qtdPessoas             Int      @map("qtd_pessoas")
  ocasiao                String?  @db.VarChar(100)
  viabilidadeEstrutura   String?  @map("viabilidade_estrutura")
  restricoesAlimentares  String?  @map("restricoes_alimentares")
  valorEstimadoTotal     Decimal  @map("valor_estimado_total") @db.Decimal(10, 2)
  status                 String   @db.VarChar(50)
  dataCriacao            DateTime @default(now()) @map("data_criacao")

  cliente        Cliente                 @relation(fields: [idCliente], references: [idCliente])
  escolhasMenu   EscolhaMenu[]
  personalizacao PersonalizacaoServico?

  @@map("Evento_Orcamento")
}

model EscolhaMenu {
  idEscolha   Int    @id @default(autoincrement()) @map("id_escolha")
  idEvento    Int    @map("id_evento")
  idPrato     Int    @map("id_prato")
  tipoEscolha String @map("tipo_escolha") @db.VarChar(50)

  evento EventoOrcamento @relation(fields: [idEvento], references: [idEvento])
  prato  PratoCardapio   @relation(fields: [idPrato], references: [idPrato])

  @@map("Escolha_Menu")
}

model PersonalizacaoServico {
  idPersonalizacao Int     @id @default(autoincrement()) @map("id_personalizacao")
  idEvento         Int     @unique @map("id_evento")
  temDecoracao     Boolean @default(false) @map("tem_decoracao")
  qtdGarcons       Int     @default(1) @map("qtd_garcons")
  mudouProteina    Boolean @default(false) @map("mudou_proteina")
  detalhesProteina String? @map("detalhes_proteina")

  evento       EventoOrcamento       @relation(fields: [idEvento], references: [idEvento])
  configuracao ConfiguracaoCockpit?

  @@map("Personalizacao_Servico")
}

model ConfiguracaoCockpit {
  idConfig          Int    @id @default(autoincrement()) @map("id_config")
  idPersonalizacao  Int    @unique @map("id_personalizacao")
  chave             String @unique @db.VarChar(100)
  valor             String @db.VarChar(255)

  personalizacao PersonalizacaoServico @relation(fields: [idPersonalizacao], references: [idPersonalizacao])

  @@map("Configuracao_Cockpit")
}